# Copy to .env (never commit it). Only needed for live LLM runs; the released judgments replay without an API key.
OPENAI_API_KEY=
OPENAI_MODEL_AGENT=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_S=8
LLM_CACHE_MODE=readwrite

# Where intermediate data, caches, trained heads and parquet results go (default: ./work)
# GENCO_WORKDIR=/path/to/fast/disk
# Where the GENCO OPF checkpoints live (default: ./checkpoints/genco-opf-datakit)
# GENCO_OPF_CKPT=/path/to/genco-opf-datakit
MLFLOW_ALLOW_FILE_STORE=true
